# Sistema
.DS_Store
Thumbs.db

# Node (apenas se alguem rodar validate.js localmente)
node_modules/

# Backups locais: histórico de trabalho, não fazem o jogo rodar.
# Mantidos na pasta, fora do repositório.
_backup/

# Imagens de conferência geradas por tools/shots.js
tools/_shots/

# cache do Python das ferramentas
__pycache__/

# corpus de estudo: PDFs de referencia e o texto extraido deles
REF/

# ==========================================================================
# MATERIAL AUTORAL - fica na pasta, fora do repositorio.
#
# O jogo nao precisa de nada disto para rodar. Sao documentos de trabalho:
# canon, biblia, estrutura, roteiro em prosa e as notas do estudo das
# referencias. Publicar junto com o jogo entregaria a obra inteira, os
# finais e o material de origem.
#
# Se um dia o projeto for aberto, basta remover este bloco.
# ==========================================================================
docs/

# Kit de reaproveitamento. Pessoal, nao entra no repo do jogo.
kit/
